<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Cadastrar Remédio"
            android:textAlignment="center"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- Foto -->
        <ImageView
            android:id="@+id/imgFoto"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginLeft="70dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="70dp"
            android:background="@drawable/edittext_bg"
            android:src="@drawable/ic_launcher_foreground"
            android:scaleType="centerCrop" />

        <Button
            android:id="@+id/btEscolherFoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="30dp"
            android:backgroundTint="@color/blue"
            android:text="Escolher Foto"
            android:textSize="16sp" />

        <!-- Tipo: sólido ou líquido -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginLeft="10dp"
            android:text="Tipo do remédio"
            android:textSize="20sp"
            android:textStyle="italic" />

        <RadioGroup
            android:id="@+id/rgTipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbSolido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sólido (comprimido)"
                android:textSize="16sp"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbLiquido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:text="Líquido"
                android:textSize="16sp" />

        </RadioGroup>

        <!-- Nome -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginLeft="10dp"
            android:text="Nome do remédio"
            android:textSize="20sp"
            android:textStyle="italic" />

        <EditText
            android:id="@+id/edtNome"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginTop="8dp"
            android:autofillHints="name"
            android:background="@drawable/edittext_bg"
            android:hint="Ex: Dorflex"
            android:inputType="textPersonName" />

        <!-- Dosagem -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginLeft="10dp"
            android:text="Dosagem (mg ou ml)"
            android:textSize="20sp"
            android:textStyle="italic" />

        <EditText
            android:id="@+id/edtDosagem"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginTop="8dp"
            android:autofillHints="name"
            android:background="@drawable/edittext_bg"
            android:hint="Ex: 500mg"
            android:inputType="text" />

        <!-- Comprimidos na cartela (só para sólido) -->
        <TextView
            android:id="@+id/lblQuantidade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginLeft="10dp"
            android:text="Comprimidos na cartela"
            android:textSize="20sp"
            android:textStyle="italic" />

        <EditText
            android:id="@+id/edtQuantidade"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginTop="8dp"
            android:autofillHints="name"
            android:background="@drawable/edittext_bg"
            android:hint="Ex: 20"
            android:inputType="number" />

        <!-- Para que serve -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginLeft="10dp"
            android:text="Para que serve"
            android:textSize="20sp"
            android:textStyle="italic" />

        <EditText
            android:id="@+id/edtDescricao"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginTop="8dp"
            android:autofillHints="name"
            android:background="@drawable/edittext_bg"
            android:hint="Ex: Dor e febre"
            android:inputType="textMultiLine"
            android:gravity="top" />

        <!-- Botão salvar -->
        <Button
            android:id="@+id/btSalvar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="30dp"
            android:layout_marginRight="30dp"
            android:layout_marginBottom="30dp"
            android:backgroundTint="@color/blue"
            android:text="Salvar"
            android:textSize="20sp" />

    </LinearLayout>
</ScrollView>