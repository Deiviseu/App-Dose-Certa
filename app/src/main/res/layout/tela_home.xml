<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".TelaHomeActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="15sp"
        android:textStyle="bold"
        android:layout_marginTop="60sp"
        android:layout_marginEnd="10sp"
        android:text="@string/titulo1"
        android:textSize="30sp" />

    <EditText
        android:layout_width="390dp"
        android:layout_height="48sp"
        android:hint="@string/buscar"
        android:autofillHints="name"
        android:background="@drawable/edittext_bg"
        android:layout_marginStart="10sp"
        android:layout_marginEnd="10sp"
        android:layout_marginTop="20sp"
        android:inputType="text"
        />

    <LinearLayout
        android:id="@+id/opc1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10sp"
        android:layout_marginTop="30sp"
        android:layout_marginEnd="10sp"
        android:background="@drawable/edittext_bg"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true"
        >

        <ImageView
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:background="@drawable/edittext_bg"
            android:src="@drawable/dorflex" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:background="@drawable/edittext_bg"
            android:text="@string/dorEFebre"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10sp"
        android:layout_marginTop="30sp"
        android:layout_marginEnd="10sp"
        android:background="@drawable/edittext_bg"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:background="@drawable/edittext_bg"
            android:src="@drawable/cimegripe" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:background="@drawable/edittext_bg"
            android:text="@string/gripeEtosse"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10sp"
        android:layout_marginTop="30sp"
        android:layout_marginEnd="10sp"
        android:background="@drawable/edittext_bg"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:background="@drawable/edittext_bg"
            android:src="@drawable/allegra" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:background="@drawable/edittext_bg"
            android:text="@string/Alergia"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10sp"
        android:layout_marginTop="30sp"
        android:layout_marginEnd="10sp"
        android:background="@drawable/edittext_bg"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:background="@drawable/edittext_bg"
            android:src="@drawable/azitromicina" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:background="@drawable/edittext_bg"
            android:text="@string/Antibióticos"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10sp"
        android:layout_marginTop="30sp"
        android:layout_marginEnd="10sp"
        android:background="@color/cardview_light_background"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/img_casa"
            android:layout_width="131sp"
            android:layout_height="50sp"
            android:src="@drawable/casa">
        </ImageView>

        <ImageView
            android:id="@+id/img_mais"
            android:layout_width="131sp"
            android:layout_height="50sp"
            android:src="@drawable/mais">
        </ImageView>

        <ImageView
            android:id="@+id/img_sino"
            android:layout_width="131sp"
            android:layout_height="50sp"
            android:src="@drawable/sino">
        </ImageView>
    </LinearLayout>



</LinearLayout>